diff --git a/src/metrics.ts b/src/metrics.ts
index 2245f06..92fdaec 100644
--- a/src/metrics.ts
+++ b/src/metrics.ts
@@ -3,7 +3,14 @@ export interface Gauge {
   value: number;
 }
 
+const FLEET_SIZE = 120;
+
 /** Jobs queued, per org. */
 export function queueDepth(queued: Record<string, number>): Gauge[] {
   return Object.entries(queued).map(([org, n]) => ({ name: `queue_depth{org="${org}"}`, value: n }));
 }
+
+/** Fraction of the runner fleet that is busy, from 0 to 1. */
+export function fleetUtilisation(busy: number): number {
+  return busy / FLEET_SIZE;
+}
