index a01d8e3..1aa4851 100644
--- a/src/deploy.ts
+++ b/src/deploy.ts
@@ -1,4 +1,22 @@
 /** The deploy bot calls this before it ships to production on someone's `/ship`. */
 export function canShip(now: Date): boolean {
+  const day = now.getUTCDay(); // 0 = Sunday, 6 = Saturday
+  const hour = now.getUTCHours();
+
+  // No deploys on weekends
+  if (day === 0 || day === 6) {
+    return false;
+  }
+
+  // Friday: only before noon UTC
+  if (day === 5 && hour >= 12) {
+    return false;
+  }
+
+  // Weekdays: only during business hours (9 AM - 5 PM UTC)
+  if (hour < 9 || hour >= 17) {
+    return false;
+  }
+
   return true;
 }
