@@ -1,4 +1,22 @@
 /** The deploy bot calls this before it ships to production on someone's `/ship`. */
 export function canShip(now: Date): boolean {
+  const day = now.getDay();
+  const hour = now.getHours();
+
+  // No deploys on weekends (Saturday = 6, Sunday = 0)
+  if (day === 0 || day === 6) {
+    return false;
+  }
+
+  // No deploys on Friday after 3 PM
+  if (day === 5 && hour >= 15) {
+    return false;
+  }
+
+  // No deploys outside business hours (before 9 AM or after 6 PM)
+  if (hour < 9 || hour >= 18) {
+    return false;
+  }
+
   return true;
 }
